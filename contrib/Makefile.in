#

LIBNAME =

SUBDIRS = msub

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME) $(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean:
	-@ rm -f *.o *.do $(CLEAN) core *~ .makedepend .*.bak cmap
	# -@ touch .makedepend
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

distclean: clean
	-@ rm -f Makefile
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done



depend:
#	makedepend -Y -I.. -f .makedepend $(CPPFILES) $(GLCPPFILES) $(CFILES)

# include .makedepend

################################################################

install:

