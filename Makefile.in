#SHELL	=	/bin/sh
DIRS	=	contrib lib src inst

all: makeinclude
	@for dir in $(DIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done
	-@ echo "========================================================"
	-@echo "make all completed..."
	-@echo "now you should run make install"
	-@ echo "========================================================"

install: all
	@echo "================================================================="
	@echo "================================================================="
	@echo "===installing to @prefix@ ==="
	@if [ ! -d @prefix@ ]; then \
		mkdir -p @prefix@ ;\
	fi
	@if [ ! -d @prefix@@bindir@ ]; then \
		mkdir @prefix@@bindir@ ;\
	fi
	@if [ ! -d @prefix@@libdir@ ]; then \
		mkdir @prefix@@libdir@ ;\
	fi
	@if [ ! -d @prefix@@mandir@ ]; then \
		mkdir @prefix@@mandir@ ;\
	fi
	@if [ ! -d @VARDIR@ ]; then \
		mkdir @VARDIR@ ;\
		chmod 777 @VARDIR@ ;\
	fi
	@for dir in $(DIRS); do\
		echo "=== installing $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) install) || exit 1;\
	done
	@(cd doc; $(MAKE) $(MFLAGS) install)
	@if test -f @prefix@@libdir@/password; then \
		echo "Not overwriting existing password file"; \
	else \
		echo "Installing @prefix@@libdir@/password"; \
		cp -p .serverpassword @prefix@@libdir@/password; \
		chmod 600 @prefix@@libdir@/password; \
	fi
	@echo "================================================================="
	@echo "XPilot5 has been installed to @prefix@"
	@echo "You may or may not add @prefix@@bindir@ to your PATH"
	@echo "To get started, try @prefix@@bindir@/xpilot5"

depend: makeinclude
	@for dir in $(DIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done

clean:
	-@ rm -f core config.cache *.o *.bck .serverpasswd
	@for dir in $(DIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

# distclean the subdirectories first
distclean: clean
	@for dir in $(DIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done
	rm -f config.log config.h config.status makeinclude .serverpassword
	-@ echo "========================================================"
	-@ echo "= Note you will need to run ./configure before you can ="
	-@ echo "= build again                                          ="
	-@ echo "========================================================"

makeinclude: configure config.h.in makeinclude.in
	if test -f config.status; then \
		./config.status --recheck; \
		./config.status; \
	else \
		./configure; \
	fi

configure: configure.ac
	autoconf

# DIK We don't need this
# $(srcdir)/configure: configure.ac aclocal.m4
# 	cd $(srcdir) && autoconf

# DIK We don't need this
# autoheader might not change config.h.in, so touch a stamp file.
#$(srcdir)/config.h.in: stamp-h.in
#$(srcdir)/stamp-h.in: configure.ac aclocal.m4
#	cd $(srcdir) && autoheader
#	echo timestamp > $(srcdir)/stamp-h.in

config.h: stamp-h
stamp-h: config.h.in config.status
	./config.status

Makefile: Makefile.in config.status
	./config.status

config.status: configure
	./config.status --recheck

