# Force the make to die on failure by using "exit 1" instead of "break" in the loops.
# Tidy up the make install output.
#
# Revision 1.1  2002/08/01 20:28:14  dick
# Install man pages.
#

###############################################################################

DIRS = man

###############################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

all:
	@if test "none" != "$(DIRS)"; then\
		for dir in $(DIRS); do\
			echo "=== making $$dir ===";\
			(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
		done\
	fi

install:
	@if test "none" != "$(DIRS)"; then\
		for dir in $(DIRS); do\
			echo "=== installing $$dir ===";\
			(cd $$dir; $(MAKE) $(MFLAGS) install) || exit 1;\
		done\
	fi

depend:
	@if test "none" != "$(DIRS)"; then\
		for dir in $(DIRS); do\
			echo "=== making dependencies in $$dir ===";\
			(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
		done\
	fi

clean:
	-@ rm -f core config.cache *.o *.bck
	@if test "none" != "$(DIRS)"; then\
		for dir in $(DIRS); do\
			echo "=== cleaning $$dir ===";\
			(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
		done\
	fi

distclean: clean
	-@ rm -f Makefile
	@if test "none" != "$(DIRS)"; then\
		for dir in $(DIRS); do\
			echo "=== distcleaning $$dir ===";\
			(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
		done\
	fi
