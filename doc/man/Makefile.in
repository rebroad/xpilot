# Install man pages.
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

MSUBTARGETS=xp-replay.man xpilot.man xpilots.man

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

MANDIR=@mandir@


#XPCXXFLAGS =

#OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:
	-@ rm -f *.o *.do $(CLEAN) core *~ .makedepend .*.bak cmap $(MSUBTARGETS)

distclean: clean
	-@ rm -f Makefile


depend:

install: $(MSUBTARGETS)

$(MSUBTARGETS): $(MSUB) $(TOP)/xpilot.version
	@echo "msub'ing $@"
	$(MSUB) $(MSUBFLAGS) -f $(TOP)/xpilot.version $@.msub >$@
	echo "Installing $@ to $(MANDIR)"
	cp $@ $(MANDIR)


# include .makedepend

################################################################

install:

