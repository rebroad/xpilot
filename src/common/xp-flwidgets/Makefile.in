LIBNAME = xp-flwidgets.a

SUBDIRS = audio kbconfig

CPPFILES = \
	Fl_PrefsColorKey.cpp Fl_ServerList.cpp Fl_Status.cpp \
	Fl_Value_Input_Counter.cpp Fl_XPColors.cpp \
	NameAndShipButton.cpp \
	ServerPrefsWindow.cpp \
	ShipDocument.FL.cpp ShipListBox.cpp ShipListViewWindow.cpp \
    XPCheckButton.cpp XPPreset_Group.cpp XPChoice.cpp \
	flUtil.cpp

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME) $(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	-@ rm -f *.o *.do $(LIBRARY) $(CLEAN) core *~ .depend cmap
	-@ touch .depend
	@for dir in $(SUBDIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

distclean: clean
	-@ rm -f Makefile
	@for dir in $(SUBDIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)
	@for dir in $(SUBDIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done

include .depend

################################################################

install:

