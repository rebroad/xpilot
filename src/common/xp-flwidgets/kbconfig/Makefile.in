# Added support for autoconf.
# Right now, "make install" is not supported.  And config.h is rather empty.
#

LIBNAME = xp-kbconfig.a

SUBDIRS =

CPPFILES = \
	Fl_KbActionButton.cpp \
	Fl_KbCButton.cpp Fl_KbConfig.cpp Fl_KbConfigBuiltIn.cpp Fl_KbConfigKb.cpp \
	Fl_KbDragger.cpp Fl_KbKbSelector.cpp Fl_KbMultiComm.cpp KbUndoableCommand.cpp

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC) $(XPFLWIDGETSINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME) $(SUBDIRS)
#	@for dir in $(SUBDIRS); do\
#		echo "=== making $$dir ===";\
#		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
#	done

$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean:
	-@ rm -f *.o *.do $(DSONAME) $(LIBRARY) $(CLEAN) core *~ ../include/*~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

#
# End of "$Id: Makefile.in,v 1.5 2004/02/28 07:54:30 dick Exp $".
