# Unix Makefiles for web component
#

LIBNAME = xpweb.a

SUBDIRS =

CPPFILES = \
	Http.cpp NetList.cpp Network.cpp

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME)

$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	-@ rm -f *.o *.do $(LIBNAME) $(CLEAN) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

#
# End of "$Id: Makefile.in,v 1.2 2002/07/04 04:38:37 dick Exp $".
