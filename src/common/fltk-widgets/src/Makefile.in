# $Log: Makefile.in,v $
# Revision 1.1  2001/09/23 06:25:27  dick
# Added support for autoconf.
# Right now, "make install" is not supported.  And config.h is rather empty.
#

LIBNAME = libfltkwidgets.a

SUBDIRS =

CPPFILES = \
	Flv_List.cpp Flv_Style.cpp Flv_Table.cpp

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = -I.. $(FLTKINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME)

$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	-@ rm -f *.o *.do $(LIBNAME) $(CLEAN) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

#
# End of "$Id: Makefile.in,v 1.1 2001/09/23 06:25:27 dick Exp $".
