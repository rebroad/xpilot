# Generated automatically from makeinclude.in by configure.

prefix		=/usr/local
exec_prefix	=${prefix}
bindir		=${exec_prefix}/bin
includedir	=${prefix}/include
libdir		=${exec_prefix}/lib
srcdir		=.

# compiler names:
CXX	=CC
CC	=cc
MAKEDEPEND =$(CXX) -M

# flags for C++ compiler:
##CFLAGS	=-O -g -lmalloc_cv
CFLAGS		=-O -g
CFLAGS_D	=-g -DDEBUG
##CXXFLAGS	=-O
CXXFLAGS	=-O -g
CXXFLAGS_D	=-g -DDEBUG

# program to make the archive:
LIBNAME		=libfltk.a
LIBNAME_D	=libfltk_d.a
AR		=ar rc
RANLIB		=:

# libraries to link with:
LDLIBS	= -lX11 -lXext  -lm

# libraries to link with when using GL:
GLDLIBS	=  -lGLU -lGL -lX11 -lXext  -lm
