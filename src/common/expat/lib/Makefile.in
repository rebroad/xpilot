# Unix expat makefiles.
#

LIBNAME = xpexpat.a

SUBDIRS =

CFILES = \
	xmlparse.c xmlrole.c xmltok.c

MSUBTARGETS =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC) $(XPFLWIDGETSINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all::	$(LIBNAME)


$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@

$(CPPFILES):

clean :
	-@ rm -f *.o *.do *.bak $(LIBNAME) $(CLEAN) $(MSUBTARGETS) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

# declarations for msub
AUTHORS=@AUTHORS@
################################################################

install:

