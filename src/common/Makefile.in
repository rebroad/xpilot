LIBNAME = libxpcommon.a

SUBDIRS = expat fltk-widgets web xp-flwidgets

CPPFILES = \
	config.cpp \
	Archive.cpp CfgBase.cpp checknames.cpp \
	Connectparam.cpp ControlClient.cpp cstring.cpp \
	error.cpp FirewallPortList.cpp FlEventNames.cpp \
	Ini.cpp Ini.cpp Ini.Save.cpp \
	IniClient.cpp IniClient.Defaults.cpp \
	IniServer.cpp IniServer.Defaults.cpp \
	keys.cpp list.cpp math.cpp microdelay.cpp \
	Obj.cpp password.cpp portability.cpp randommt.cpp \
	ServerList.cpp ServerOptionsNetClient.cpp ServerOptionsNetClientFl.cpp ServerSite.cpp \
	ShipDocument.cpp ShipList.cpp shipshape.cpp showtime.cpp Sock.cpp Sockbuf.cpp sockerrs.cpp \
	strcasecmp.cpp strdup.cpp strlcpy.cpp \
	UndoableCommand.cpp UndoMan.cpp WildMap.cpp \
	XMLArchive.cpp xpmemory.cpp XpPoint.cpp XpPointList.cpp xpprintf.cpp

MSUBTARGETS = version.h

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(OSFLAG) $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC) $(XPFLWIDGETSINC) $(EXPATLIBINC) $(WEBLIBINC)

CONFIGFLAGS= -DVARDIR="\"$(VARDIR)/\"" -DLIBDIR="\"$(LIBDIR)/\"" -DBINDIR="\"$(BINDIR)/\"" -DBROWSER="\"$(BROWSER)\""

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:: version.h

all::	$(LIBNAME) $(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

$(LIBNAME): version.h $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@

config.o:
	$(CXX) $(XPCXXFLAGS) $(CONFIGFLAGS) -c config.cpp
$(CPPFILES): version.h

#$(MSUBTARGETS): $(MSUB) $<.msub
version.h: $(MSUB) version.h.msub $(TOP)/xpilot.version
	@echo "msub'ing version.h"
	$(MSUB) $(MSUBFLAGS) -f $(TOP)/xpilot.version version.h.msub >$@

$(MSUB): $(MSUB).o $(MSUB).c
	@echo "Checking $@ over in $(MSUBSRC) first.."; \
	cd $(MSUBSRC) || exit 1; $(MAKE) || exit 1; \
	echo "Okay, continuing in $(CURRENT_DIR)"

clean :
	-@ rm -f *.o *.do *.bak $(LIBNAME) $(CLEAN) $(MSUBTARGETS) core *~ .depend cmap
	-@ touch .depend
	@for dir in $(SUBDIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

distclean: clean
	-@ rm -f Makefile .depend
	@for dir in $(SUBDIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done

depend: version.h
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)
	@for dir in $(SUBDIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done

include .depend

# declarations for msub
AUTHORS=@AUTHORS@
################################################################

install:

#
