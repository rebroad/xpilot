# Right now, "make install" is not supported.  And config.h is rather empty.


# DIRS= replay  # leave out replay for now.
DIRS = common client serverlib server scoreserver control

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

all:
	@for dir in $(DIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

install:
	@for dir in $(DIRS); do\
		echo "=== installing $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) install) || exit 1;\
	done

depend:
	@for dir in $(DIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done

clean:
	-@ rm -f core config.cache *.o *.bck
	@for dir in $(DIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

distclean: clean
	-@ rm -f Makefile
	@for dir in $(DIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done
