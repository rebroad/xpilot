LIBNAME = libxpserverlib.a

SUBDIRS =

CPPFILES = \
	Connection.cpp File.cpp NetServer.cpp NetServer.sched.cpp \
	ServerOption.cpp ServerOptions.cpp

LIBS = \
	$(COMMONLIB)

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

#XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC)
XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME) $(SUBDIRS)

$(LIBNAME): $(OBJECTS) $(LIBS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	-@ rm -f *.o *.do $(LIBRARY) $(CLEAN) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

#
