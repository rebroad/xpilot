# Unix Makefile for the SQL Engine
#

LIBNAME = libscoreengineSQL.a

SUBDIRS =

CPPFILES = \
	ScoreEngineSoloSQL.cpp ScoreEngineSoloSQLCfg.cpp


CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(EXPATLIBINC) $(WEBLIBINC) $(MYSQLINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)


all::	$(LIBNAME)


$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	-@ rm -f *.o *.do $(LIBNAME) $(CLEAN) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

#
# End of "$Id: Makefile.in,v 1.1 2007/01/30 06:54:12 dick Exp $".
