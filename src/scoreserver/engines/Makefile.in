LIBNAME = libscoreengines.a

SUBDIRS = @MYSQLBUILD@

CPPFILES = \
	ScoreEngine.cpp ScoreEngineCfg.cpp \
	ScoreEngineBasic.cpp ScoreEngineBasicCfg.cpp \
	ScoreEngineBasicXML.cpp ScoreEngineBasicXMLCfg.cpp


CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(EXPATLIBINC) $(WEBLIBINC)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all::	$(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

all::	$(LIBNAME)


$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	@for dir in $(SUBDIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done
	-@ rm -f *.o *.do $(LIBNAME) $(CLEAN) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	@for dir in $(SUBDIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done
	-@ rm -f Makefile

depend:
	@for dir in $(SUBDIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

#
