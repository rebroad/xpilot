PROGNAME = xpscoreserver

SUBDIRS = engines

CPPFILES = \
	ConnectionLocalCtl.cpp \
	HttpScore.cpp NetServerScoreServer.cpp \
	ScoreEngineSelector.cpp ScoreServer.cpp ScoreServerCfg.cpp \
	ScoreServerNetClient.cpp ScoreServerUnix.cpp

CLEAN =

SCOREENGINELIB = engines/libscoreengines.a

DEPLIBS = $(COMMONLIB) $(SERVERLIBLIB) $(EXPATLIBLIB) $(WEBLIBLIB) $(SCOREENGINELIB)

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(EXPATLIBINC) $(WEBLIBINC) $(VARRUN)
XPLDFLAGS =  $(SERVERLIBLIB) $(COMMONLIB) $(EXPATLIBLIB) $(WEBLIBLIB) $(SCOREENGINELIB)


OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)


all::	$(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

all::	$(PROGNAME)

$(PROGNAME): $(OBJECTS) $(DEPLIBS)
	echo $(CXX) $@ ...
	$(CXX) -o $@ $(OBJECTS) $(XPLDFLAGS) $(LDFLAGS) $(LDLIBS)


clean :
	@for dir in $(SUBDIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done
	-@ rm -f *.o *.do $(PROGNAME) $(CLEAN) core *~ *.bak .depend .*.bak cmap
	-@ touch .depend

distclean: clean
	@for dir in $(SUBDIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done
	-@ rm -f Makefile .depend

depend:
	@for dir in $(SUBDIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(GLCPPFILES) $(CFILES)

include .depend

################################################################

install:
	@echo Installing $(bindir)/$(PROGNAME)
	cp -f -p $(PROGNAME) $(bindir)
	chmod 555 $(bindir)/$(PROGNAME)

#
# End of "$Id: Makefile.in,v 1.9 2004/04/22 05:55:58 dick Exp $".
