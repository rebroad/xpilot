# Robots in subdirectories builds on Linux
#


LIBNAME = librobots.a

SUBDIRS =

CPPFILES = \
	Robot.cpp Robot4.cpp Robot5.cpp RobotMan.cpp \
	defaultFactory.cpp testFactory.cpp

LIBS = \
	$(COMMONLIB)

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

#XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC)
XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) -I ..

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME) $(SUBDIRS)

$(LIBNAME): $(OBJECTS) $(LIBS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean :
	-@ rm -f *.o *.do $(LIBRARY) $(CLEAN) core *~ .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:

