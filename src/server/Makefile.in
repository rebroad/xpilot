PROGNAME = xpilotserver

SUBDIRS = robots

CPPFILES = \
	Alliance.cpp asteroid.cpp Cannon.cpp cmdline.cpp command.cpp \
	ConnectionControl.cpp ConnectionControlLocalCtl.cpp \
	ConnectionControlScoreServer.cpp ConnectionPlayer.cpp \
	event.cpp fileparser.cpp Frame.cpp \
	id.cpp item.cpp laser.cpp metaserver.cpp \
	Object.cpp objpos.cpp option.cpp \
	Player.cpp \
	saudio.cpp score.cpp \
	ServerOptionWorld.cpp ship.cpp shot.cpp \
	update.cpp \
	World.cpp World.cell.cpp World.collision.cpp World.contact.cpp \
	World.main.cpp World.netserver.cpp World.parser.cpp World.play.cpp \
	World.rules.cpp World.ScoreServer.cpp World.tag.cpp World.walls.cpp

ROBOTLIB = robots/librobots.a

DEPLIBS = \
	$(SERVERLIBLIB) $(COMMONLIB) $(ROBOTLIB)

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

#XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC)
XPCXXFLAGS = $(COMMONINC) $(SERVERLIBINC) $(SERVERSOUND) -I robots/
XPLDFLAGS = $(COMMONLIB) $(SERVERLIBLIB) $(ROBOTLIB)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all::	$(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

all::	$(PROGNAME)

$(PROGNAME): $(OBJECTS) $(DEPLIBS)
	echo $(CXX) $@ ...
	$(CXX) -o $@ $(OBJECTS) $(XPLDFLAGS) $(LDFLAGS) $(LDLIBS)


clean :
	@for dir in $(SUBDIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done
	-@ rm -f *.o *.do $(PROGNAME) $(CLEAN) core *~ *.bak .depend cmap
	-@ touch .depend

distclean: clean
	@for dir in $(SUBDIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done
	-@ rm -f Makefile

depend:
	@for dir in $(SUBDIRS); do\
		echo "=== making dependencies in $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done
	-@ makedepend $(OSFLAG) $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:
	@echo Installing $(bindir)/$(PROGNAME)
	cp -f -p $(PROGNAME) $(bindir)
	chmod 555 $(bindir)/$(PROGNAME)

#
# End of "$Id: Makefile.in,v 1.22 2007/01/11 05:08:13 dick Exp $".
