# Revision 1.3  2002/08/01 20:27:22  dick
# Better KDE detection.  Install man pages.
#
# Rename programs:
# src/         Windows              Unix
# control      XPilot.exe           xpilot
# client       XPilotClient.exe     xpilotclient
# server       XPilotServer.exe     xpilotserver
# scoreserver  XPScoreServer.exe    xpscoreserver
# replay       XPReplay.exe         xpreplay
#
# Revision 1.2  2001/10/24 16:40:19  dick
# Add support for "make install"
#
# Revision 1.1  2001/09/23 06:25:27  dick
# Added support for autoconf.
# Right now, "make install" is not supported.  And config.h is rather empty.
#

PROGNAME = xpreplay

SUBDIRS =

CPPFILES = \
	xp-replay.c buttons.c

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

#XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC)
XPCXXFLAGS = $(COMMONINC) ../client
XPLDFLAGS = $(COMMONLIB)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(PROGNAME)

$(PROGNAME): $(OBJECTS)
	echo $(CXX) $@ ...
	$(CXX) -o $@ $(OBJECTS) $(XPLDFLAGS) $(LDFLAGS) $(LDLIBS)


clean:
	-@ rm -f *.o *.do $(PROGNAME) $(CLEAN) core *~ *.bak .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	makedepend -Y -I.. -f .depend $(CPPFILES) $(GLCPPFILES) $(CFILES)

include .depend

################################################################

install:
	@echo Installing $(bindir)/$(PROGNAME)
	cp -p $(PROGNAME) $(bindir)
	chmod 555 $(bindir)/$(PROGNAME)

#
# End of "$Id: Makefile.in,v 1.3 2002/08/01 20:27:22 dick Exp $".
#
