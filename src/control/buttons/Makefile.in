# Please report all bugs and problems to "xpilot++@buckosoft.com".
#
# $Log: Makefile.in,v $
# Revision 1.4  2004/01/20 06:13:53  dick
# Add support for `make install` to a non-priv'd directory, like /home/dick/xpilot.
# If we are doing a default installation (/usr/local/xpilot) then the VARDIR
# becomes /var/xpilot .  If we are not default then use $prefix/var.
#
# Revision 1.3  2004/01/05 05:45:05  dick
# Install the png files too
#
# Revision 1.2  2002/02/18 03:39:36  dick
# Output one . for each button installed
#
# Revision 1.1  2002/02/17 22:33:58  dick
# Install xpilotedit's buttons to $/lib/buttons ( /usr/local/games/lib/buttons )
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:

distclean: clean

depend:

################################################################

install:
	@echo "=== installing buttons to $(BUTTONDIR)"
	@if [ ! -d $(BUTTONDIR) ]; then \
		mkdir $(BUTTONDIR) ;\
	fi
	@for butt in *.xpm *.png; do\
		cp -f -p $$butt $(BUTTONDIR);\
		echo $(ECHO_N) ".";\
		chmod 444 $(BUTTONDIR)/$$butt;\
	done
	@echo ""

#
# End of "$Id: Makefile.in,v 1.4 2004/01/20 06:13:53 dick Exp $".
#
