# @configure_input@
#
# Makefile.in for xpilot++'s library of installed buttons for xpilotedit
# ./src/xpilotedit/buttons/Makefile.in
#
# This module contains the button pixmaps used by the xpilotedit component
# of xpilot++
#
# Copyright 2002 by XPilot Team "xpilot@xpilot.org"
#
