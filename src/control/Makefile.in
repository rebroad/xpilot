PROGNAME = xpilot5

SUBDIRS = buttons res

CPPFILES = \
	Clipboard.cpp EditorsPanel.cpp errors.cpp gui_toolkit.cpp \
	InetServerConfig.cpp InetServerList.cpp InetServerPanel.cpp \
	IniXPilot.cpp IniXPilot.Defaults.cpp \
	LocalServerControlClient.cpp \
	LocalServerPanel.cpp LocalServerPanelAdvanced.cpp LocalServerPanelSimple.cpp \
	LocalServerPanelWorld.cpp MainButtonsPanel.cpp \
	MapDocument.cpp MapEditWindow.cpp MapUndoableCommand.cpp MapWindow.cpp \
	PrivatePanelEditButton.cpp PrivatePanelEditor.cpp \
	PrivateServerConfig.cpp PrivateServerList.cpp PrivateServerPanel.cpp \
	ScoreServerControlClient.cpp ServerButtonsGroup.cpp ServerOptionsToImage.cpp \
	ShipEditWindow.cpp ShipUndoableCommand.cpp ShipWindow.cpp \
	SplashPanel.cpp \
	tools.cpp\
	XPClientConfig.cpp XPFileChooser.cpp XPFileChooser2.cpp XPilotControl.cpp XPInput.cpp \
	XPilotControlWindow.cpp XPPresetConfig.cpp XPVisualList.cpp XPVisual.cpp


LIBS = \
	$(SERVERLIBLIB) $(XPFLWIDGETSLIB) $(FLTKWIDGETSLIB) $(FLTKIMAGESLIB) \
	$(COMMONLIB) $(KBCONFIGLIB)

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS = $(SERVERLIBINC) $(KBCONFIGINC) $(XPFLWIDGETSINC) $(FLTKWIDGETSINC) $(COMMONINC)
XPLDFLAGS =  $(SERVERLIBLIB) $(KBCONFIGLIB) $(XPFLWIDGETSLIB) $(FLTKWIDGETSLIB) $(COMMONLIB)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(PROGNAME)

$(PROGNAME): $(OBJECTS) $(LIBS)
	echo $(CXX) $@ ...
	$(CXX) -o $@ $(OBJECTS) $(XPLDFLAGS) $(LDFLAGS) $(LDLIBS)


clean :
	-@ rm -f *.o *.do $(PROGNAME) $(CLEAN) core *~ *.bak .depend .*.bak cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(XPCXXFLAGS) $(FLTKINC) -I /usr/local/include -f .depend $(CPPFILES) $(GLCPPFILES) $(CFILES)

include .depend

################################################################

install:
	@echo Installing $(bindir)/$(PROGNAME)
	cp -f -p $(PROGNAME) $(bindir)
	chmod 555 $(bindir)/$(PROGNAME)
	@for dir in $(SUBDIRS); do\
		echo "=== installing $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) install) || exit 1;\
	done


#
