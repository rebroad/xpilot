#
# $Log: Makefile.in,v $
# Revision 1.1  2004/02/28 08:02:23  dick
# Install the control bitmap buttons from src/control/res to $/buttons
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:

distclean: clean

depend:

################################################################

install:
	@echo "=== installing control buttons to $(BUTTONDIR)"
	@if [ ! -d $(BUTTONDIR) ]; then \
		mkdir $(BUTTONDIR) ;\
	fi
	@for butt in *.png; do\
		cp -f -p $$butt $(BUTTONDIR);\
		echo $(ECHO_N) ".";\
		chmod 444 $(BUTTONDIR)/$$butt;\
	done
	@echo ""

#
# End of "$Id: Makefile.in,v 1.1 2004/02/28 08:02:23 dick Exp $".
#
