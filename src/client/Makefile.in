# Revision 1.12  2007/02/17 19:46:11  dick
# Audio moved to common/AudioMan
#
# Revision 1.11  2007/01/17 23:20:31  dick
# Unix client needs RobotWatchMan
#
# Revision 1.10  2004/06/03 06:04:42  dick
# struct other_t becomes class Other.
# array Others becomes ObjList others.
# shipobj becomes ShipObj.
#
# Revision 1.9  2004/05/05 01:24:12  dick
# Add Sound.cpp and SoundEvent.cpp
#
# Revision 1.8  2004/05/02 03:08:00  dick
# Audio support.  Separate client and server audio support.
# Servers will probably always build with -DSOUND
# Clients will build -DSOUND only if OpenAL is present.
#
# Revision 1.7  2004/01/20 06:13:53  dick
# Add support for `make install` to a non-priv'd directory, like /home/dick/xpilot.
# If we are doing a default installation (/usr/local/xpilot) then the VARDIR
# becomes /var/xpilot .  If we are not default then use $prefix/var.
#
# Revision 1.6  2004/01/15 07:18:47  dick
# Don't need to spec -D_UNIX 2 (or 3) times on the command line.  Once is enough.
#
# Revision 1.5  2004/01/07 18:38:46  dick
# Pass OSFLAG to make depend so it won't look for w32 includes.
#
# Revision 1.4  2002/08/01 20:27:22  dick
# Better KDE detection.  Install man pages.
#
# Rename programs:
# src/         Windows              Unix
# control      XPilot.exe           xpilot
# client       XPilotClient.exe     xpilotclient
# server       XPilotServer.exe     xpilotserver
# scoreserver  XPScoreServer.exe    xpscoreserver
# replay       XPReplay.exe         xpreplay
#
# Revision 1.3  2001/10/24 16:40:19  dick
# Add support for "make install"
#
# Revision 1.2  2001/10/09 15:50:00  dick
# Add library dependancies. (Useful when not rebuilding all...)
#
# Revision 1.1  2001/09/23 06:25:27  dick
# Added support for autoconf.
# Right now, "make install" is not supported.  And config.h is rather empty.
#


PROGNAME = xpilotclient

SUBDIRS =

CPPFILES = \
	about.cpp blockbitmaps.cpp \
	client.cpp colors.cpp configure.cpp \
	datagram.cpp dbuff.cpp \
	gfx2d.cpp gfx3d.cpp guimap.cpp guiobjects.cpp \
	join.cpp netclient.cpp \
	Other.cpp \
	paint.cpp paintdata.cpp painthud.cpp paintmap.cpp \
	paintobjects.cpp paintradar.cpp query.cpp \
	record.cpp RobotWatchMan.cpp \
	sim.cpp syslimit.cpp Sound.cpp SoundEvent.cpp \
	talk.cpp talkmacros.cpp textinterface.cpp texture.cpp \
	welcome.cpp widget.cpp xeventhandlers.cpp \
	xevent.cpp xinit.cpp xpilot.cpp xpmread.cpp

#	$(AUDIOSRC)

LIBS = \
	$(COMMONLIB)

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

#XPCXXFLAGS = $(SERVERLIBINC) $(COMMONINC) $(FLTKWIDGETSINC)
XPCXXFLAGS	= $(COMMONINC) $(CLIENTSOUND)
XPLDFLAGS	= $(COMMONLIB) $(CLIENTSOUNDLIB)

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(PROGNAME)

$(PROGNAME): $(OBJECTS) $(COMMONLIB)
	echo $(CXX) $@ ...
	$(CXX) -o $@ $(OBJECTS) $(XPLDFLAGS) $(LDFLAGS) $(LDLIBS)


clean :
	-@ rm -f *.o *.do $(PROGNAME) $(CLEAN) core *~ *.bak .depend cmap
	-@ touch .depend

distclean: clean
	-@ rm -f Makefile

depend:
	-@ makedepend $(OSFLAG) $(XPCXXFLAGS) $(FLTKINC) -f .depend $(CPPFILES) $(CFILES)

include .depend

################################################################

install:
	@echo Installing $(bindir)/$(PROGNAME)
	cp -f -p $(PROGNAME) $(bindir)
	chmod 555 $(bindir)/$(PROGNAME)

#
# End of "$Id: Makefile.in,v 1.12 2007/02/17 19:46:11 dick Exp $".
#
