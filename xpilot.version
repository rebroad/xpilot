# "5.0.0a1-NT-rank" instead.
#
# Revision 1.10  2004/01/07 18:38:46  dick
# Pass OSFLAG to make depend so it won't look for w32 includes.
#


# Version strings:
# IMPORTANT!   If you're working on an unofficial version, please
# change the VERSION_STATUS field to avoid confusion.  
# The official version will have a VERSION_STATUS of blank, 
# or a0, a1, a2, etc. for ALPHA releases
# or b0, b1, b2, etc for BETA releases.
# or alpha or beta for xpilot 4.x releases
# please do not use these designations.
# XPilot5 deviates from the xpilot 4.x standard of using the words
# alpha and beta because the string "5.0.0alpha1-NT-rank" is too
# big to fit in the meta string (14 chars max).
#
      VERSION_MAJOR = 5
      VERSION_MINOR = 0
 VERSION_PATCHLEVEL = 1
     VERSION_STATUS = a3
        RELEASEDATE = February 19, 2007


#
# Address to send bug reports etc.  (Must not be quoted)
#
#ifndef ContactAddress
#define ContactAddress	xpilot@buckosoft.com
#endif /* ContactAddress */


#
# Copyright etc.
#
      AUTHORS = Dick Balaska, Jarrod Miller, Bert Gijsbers, Bjørn Stabell & Ken Ronny Schouten
COPYRIGHTDATE = 1991-2005
    COPYRIGHT = Copyright © $(COPYRIGHTDATE) by $(AUTHORS)
        TITLE = XPilot $(VERSION)
      VERSION = $(VERSION_MAJOR).$(VERSION_MINOR).$(VERSION_PATCHLEVEL)$(VERSION_STATUS)
   WINVERSION = $(VERSION)-NT

