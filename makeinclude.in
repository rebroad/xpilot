# Revision 1.23  2004/05/04 00:23:30  dick
# Linux needs to install client sound.conf and sounds/*.wav
#
# Revision 1.22  2004/05/02 03:08:00  dick
# Audio support.  Separate client and server audio support.
# Servers will probably always build with -DSOUND
# Clients will build -DSOUND only if OpenAL is present.
#

# Be quiet when building...
#.SILENT:
@SILENTBUILD@

prefix		=@prefix@
exec_prefix	=@exec_prefix@
bindir		=@bindir@
datadir		=@datadir@
includedir	=@includedir@
libdir		=@libdir@
mandir		=@mandir@
srcdir		=@srcdir@
#VPATH		=@srcdir@
VARRUN		=-DVARRUN=\"@VARRUND@\"

XPLIBDIR	=$(libdir)
MAPDIR		=$(XPLIBDIR)/maps
SOUNDDIR	=$(XPLIBDIR)/sounds
TEXTUREDIR	=$(XPLIBDIR)/textures
BUTTONDIR	=$(XPLIBDIR)/buttons
VARDIR		=@VARDIR@
LIBDIR		=@prefix@/lib
BINDIR		=@prefix@/bin

# programs we use...
HTMLDOC		=@HTMLDOC@
NROFF		=@NROFF@
ECHO_N		=@ECHO_N@
BROWSER		=@BROWSER@

# compiler names:
CXX		=@CXX@
CC		=@CC@
MAKEDEPEND	=@MAKEDEPEND@

# flags for C++ compiler:
CFLAGS			=@CPPFLAGS@ @CFLAGS@
CXXFLAGS		=@FLTKINC@ @CPPFLAGS@ @CXXFLAGS@
FLTKINC			=@FLTKINC@

# sound support
SERVERSOUND		=@SERVERSOUND@
CLIENTSOUND		=@CLIENTSOUND@
CLIENTSOUNDLIB	=@CLIENTSOUNDLIB@
CLIENTSOUNDCONF	=@CLIENTSOUNDCONF@
CLIENTSOUNDDIR	=@CLIENTSOUNDDIR@

# pass the includes to makedepend
XINCLUDES		=@XINCLUDES@

# which operating system are we building on.
OSFLAG			=@OSFLAG@

# program to make the archive:
#LIBNAME		=@LIBNAME@
#LIBNAME		=$(LIBNAME)
GLLIBNAME		=@GLLIBNAME@
LIBCOMMAND		=@LIBCOMMAND@
RANLIB			=@RANLIB@
DSONAME			=@DSONAME@
GLDSONAME		=@DSONAME@
DSOCOMMAND		=@DSOCOMMAND@

# libraries to link with:
IMAGELIBS		=@IMAGELIBS@
LDLIBS			=@LDFLAGS@ @LIBS@ @FLTKLIB@ @FLTKIMAGESLIB@ @IMAGELIBS@ -lX11 -lXext @X_EXTRA_LIBS@ -lm
#GLDLIBS		=@LDFLAGS@ @LIBS@ @GLLIB@ -lX11 -lXext @X_EXTRA_LIBS@ -lm
#LINKFLTK		=-L../lib @LINKFLTK@
#LINKFLTKGL		=-L../lib @LINKFLTKGL@
#IMAGELIBS		=@IMAGELIBS@

# if kde is available, define KDE = kde
KDE			= @KDE@

# additional xpilot++ include directories
COMMONINC		= -I $(TOP)/src/common
COMMONLIB		=    $(TOP)/src/common/libxpcommon.a
FLTKWIDGETSINC	= -I $(TOP)/src/common/fltk-widgets
FLTKWIDGETSLIB	=	 $(TOP)/src/common/fltk-widgets/src/libfltkwidgets.a
XPFLWIDGETSINC	= -I $(TOP)/src/common/xp-flwidgets
XPFLWIDGETSLIB	=	 $(TOP)/src/common/xp-flwidgets/xp-flwidgets.a
KBCONFIGINC		= -I $(TOP)/src/common/xp-flwidgets/kbconfig
KBCONFIGLIB		=	 $(TOP)/src/common/xp-flwidgets/kbconfig/xp-kbconfig.a
SERVERLIBINC	= -I $(TOP)/src/serverlib
SERVERLIBLIB	=	 $(TOP)/src/serverlib/libxpserverlib.a
EXPATLIBINC		= -I $(TOP)/src/common/expat/lib
EXPATLIBLIB		=	 $(TOP)/src/common/expat/lib/xpexpat.a
WEBLIBINC		= -I $(TOP)/src/common/web
WEBLIBLIB		=    $(TOP)/src/common/web/xpweb.a


# msub functionality
MSUBFLAGS	= +R"@<" -R">@"
MSUBSRC		= $(TOP)/contrib/msub
MSUB		= $(TOP)/contrib/msub/msub

# Man page extensions...
CAT1EXT		=@CAT1EXT@
CAT3EXT		=@CAT3EXT@

# current version information
include $(TOP)/xpilot.version

# Build commands and filename extensions...
.SUFFIXES:	.0 .1 .3 .c .cpp .h .fl .man .o .z

.cpp:
	echo Compiling and linking $@  ...
	$(CXX) -I.. $(CXXFLAGS) $< $(LINKFLTK) $(LDLIBS) -o $@

.c.o:
	echo Compiling $@  ...
	$(CC) -I.. $(CFLAGS) -c $<

.cpp.o:
	echo Compiling $< ...
	$(CXX) $(XPCXXFLAGS) $(CXXFLAGS) -c $<

.man.0 .man.1 .man.3:
	echo Formatting $<  ...
	rm -f $@
	$(NROFF) -man $< >$@

.man.z:
	echo Formatting $<  ...
	rm -f $@ t.z
	$(NROFF) -man $< >t
	pack -f t
	mv t.z $@


#
# End of "$Id: makeinclude.in,v 1.23 2004/05/04 00:23:30 dick Exp $".
#
