# $Log: Makefile.in,v $
# Revision 1.6  2004/01/28 05:53:12  dick
# Force the make to die on failure by using "exit 1" instead of "break" in the loops.
# Tidy up the make install output.
#
# Revision 1.5  2004/01/20 06:13:53  dick
# Add support for `make install` to a non-priv'd directory, like /home/dick/xpilot.
# If we are doing a default installation (/usr/local/xpilot) then the VARDIR
# becomes /var/xpilot .  If we are not default then use $prefix/var.
#
# Revision 1.4  2002/08/01 20:27:21  dick
# Better KDE detection.  Install man pages.
#
# Rename programs:
# src/         Windows              Unix
# control      XPilot.exe           xpilot
# client       XPilotClient.exe     xpilotclient
# server       XPilotServer.exe     xpilotserver
# scoreserver  XPScoreServer.exe    xpscoreserver
# replay       XPReplay.exe         xpreplay
#
# Revision 1.3  2002/07/30 07:01:06  dick
# Move install helper directories to ./inst
#
# Revision 1.2  2002/07/30 05:53:03  dick
# Move lib/kde to install/kde and src/common/NT/bindist to install/win32
#
# Revision 1.1  2002/07/26 06:28:56  dick
# Install XPilot++ into the kde games menu
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

DESKTOPDIR=@kdemenu@
ICONDIR=@kdedir@/share/icons/locolor/16x16/apps
LAUNCHEXE=@bindir@/xpilot

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:
	-@ rm -f *.o *.do $(CLEAN) core *~ .makedepend .*.bak cmap

distclean: clean
	-@ rm -f Makefile


depend:
#	makedepend -Y -I.. -f .makedepend $(CPPFILES) $(GLCPPFILES) $(CFILES)

install:
	echo "Installing xpilot.desktop to $(DESKTOPDIR)"
	-rm -f $(DESKTOPDIR)/xpilot.desktop
	-sed 's|\[XPILOT\]|$(LAUNCHEXE)|g' <xpilot.desktop >$(DESKTOPDIR)/xpilot.desktop
	echo "Installing xpilot icon to $(ICONDIR)/xpilot.png"
	-cp -f -p xpilot16x16.png $(ICONDIR)/xpilot.png

# include .makedepend

################################################################

install:

#
# End of "$Id: Makefile.in,v 1.6 2004/01/28 05:53:12 dick Exp $".
