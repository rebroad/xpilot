################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude


#MsubTarget(README.txt,README.txt.msub)
#MsubTarget(READMEbin.txt,READMEbin.txt.msub)
#MsubTarget(ServerMOTD.txt,ServerMOTD.txt.msub)

MSUB = $(TOP)/contrib/msub/msub
MSUBFLAGS = +R"@<" -R">@"


all:: README.txt
README.txt: $(MSUB) README.txt.msub
	$(MSUB) $(MSUBFLAGS) README.txt.msub >README.txt

cleandir::
	$(RM) README.txt

all:: READMEbin.txt
READMEbin.txt: $(MSUB) READMEbin.txt.msub
	$(MSUB) $(MSUBFLAGS) READMEbin.txt.msub >READMEbin.txt

cleandir::
	$(RM) READMEbin.txt

all:: ServerMOTD.txt
ServerMOTD.txt: $(MSUB) ServerMOTD.txt.msub
	$(MSUB) $(MSUBFLAGS) ServerMOTD.txt.msub >ServerMOTD.txt

cleandir::
	$(RM) ServerMOTD.txt

clean:
	-@ rm -f core config.cache *.o *.bck

depend:
