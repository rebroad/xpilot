#!/bin/bash
# $Id: makeDistribution,v 1.44 2007/01/06 18:38:11 dick Exp $
# makeDistribution - a script to move things to a directory to make the build script
#                    and then call makensis to build a Windows binary distribution for
#                    XPilot, a multiplayer gravity war game.
#                    Copyright (C) 2001 by XPilot Team <xpilot@xpilot.org>
#                    Released under GNU General Public License Version 2
#
# If you're wondering what the heck this file is...
# Here's a nickel, kid, buy yourself a real shell.  http://www.cygwin.com/
# The NullSoft Install System can be found here http://www.nullsoft.com/free/nsis/
#set -x

# directory to stage the distribution.
# You probably shouldn't make this C:\XPilot5 (The default installation dir)
XDIR=/c/staged/XPilot5

# point to your fltk installation
# not really needed anymore because you pointed VC++ at your fltk.
#FLTKDIR="E:/fltk"

# point to your NSIS installation
NSIS='/c/Program Files/NSIS'


# copy and install the XPilot bitmaps
COPYBITMAPS=Y

BUILDTYPE=Release

#!#!#!#!#!#!#!#!#!#!#!#!#!# END OF USER CONFIGURATION #!#!#!#!#!#!#!#!#!#!#!#!#!#

PRODUCT="XPilot5"

ECHO_ON="set -x"
ECHO_OFF="set +x"

#
function doHELP ()
{
	echo "makeDistribution [-aqQdcsh]"
	echo "  -a = All - does clean before builds."
	echo "  -q = Quick - doesn't do the builds (they'd better be built)."
	echo "  -Q = Very Quick - doesn't copy the bitmaps either (just run nsis)."
	echo "  -d = Debug builds"
	echo "  -c = Clean - Just clean and exit, saves disk space."
	echo "  -s = Silent - output less noise."
	echo "  -h = Help - this text"
}

#####################################################################
#
# Preset all default variables
#
ALL=N
QUICK=N
REALQUICK=N
SILENT=N
CLEANONLY=N

#####################################################################
#
# parse the command line options
#
while getopts "acdhsHqQ" OPT
do
	case $OPT in
		a) ALL=Y ;;
		q) QUICK=Y ;;
		Q) REALQUICK=Y ;;
		s) SILENT=Y ;;
		d) BUILDTYPE=Debug ; echo "Debug build" ;;
		c) CLEANONLY=Y ;;
		h) doHELP ; exit 1 ;;
		*) doHELP ; exit 1 ;;
	esac
done

if [ $REALQUICK = Y ]
then
	QUICK=Y
	COPYBITMAPS=N
fi

#####################################################################
#
# sanity check are we building from the right place?
#
cd ../..
BASE=`pwd`
echo "Building from $BASE"
echo "Building to $XDIR"
X=`echo * | grep XPilot5.dsw`
if [ "x$X" = "x" ]
then
	echo "?? $BASE"
	echo "This does not appear to be an XPilot5 source tree"
	exit 1
fi

#####################################################################
#
# set up for for fltk
#
if [ "x$FLTKDIR" != "x" ]
then
	X=`echo $INCLUDE | grep $FLTKDIR`
	if [ "x$X" = "x" ]
	then
		echo "Appending fltk to your include path"
		export "INCLUDE=$INCLUDE;$FLTKDIR"
	fi
	X=`echo $LIB | grep $FLTKDIR`
	if [ "x$X" = "x" ]
	then
		echo "Appending fltk to your library path"
		export "LIB=$LIB;$FLTKDIR/lib"
	fi
fi

#####################################################################
#####################################################################
#
# Just cleanup our workspace
#
if [ $CLEANONLY = Y ]
then
	for BUILDTYPE in Release Debug
	do
		cd $BASE/src/client/NT
		cmd /c msdev XPilotClient.dsp /MAKE "XPilotClient - Win32 $BUILDTYPE" /CLEAN
		cd $BASE/src/server/NT
		cmd /c msdev xpilots.dsp /MAKE "XPilotServer - Win32 $BUILDTYPE" /CLEAN
		cd $BASE/src/scoreserver
		cmd /c msdev XPScoreServer.dsp /MAKE "XPScoreServer - Win32 $BUILDTYPE" /CLEAN
		cd $BASE/src/replay/NT
		cmd /c msdev XPreplay.dsp /MAKE "XPreplay - Win32 $BUILDTYPE" /CLEAN
		cd $BASE/src/control
		cmd /c msdev XPilot5.dsp /MAKE "XPilot5 - Win32 $BUILDTYPE" /CLEAN
	done
	exit 0
fi

#####################################################################
#####################################################################
#
# go make XPilotClient.exe
#
if [ $QUICK = N ]
then
	echo go make XPilotClient.exe

#	if [ $BASE/doc/CREDITS -nt $BASE/src/client/NT/credits.inc.h ]
#	then
#		echo "Updating credits.inc.h based on CREDITS"
#		cd $BASE/inst/win32		# first make the credits include file
#		./creditsUpdate.pl
#	fi

	cd $BASE/src/client/NT
	if [ $ALL = Y ]
	then
		cmd /c msdev XPilotClient.dsp /MAKE "XPilotClient - Win32 $BUILDTYPE" /CLEAN
	fi
	cmd /c msdev XPilotClient.dsp /MAKE "XPilotClient - Win32 $BUILDTYPE"
	if [ $? != 0 ]
	then
		echo "makeDistribution: failed to build XPilotClient.exe"
		exit 1
	fi
fi

#####################################################################
#
# go make XPilotServer.exe
#
if [ $QUICK = N ]
then
	echo go make XPilotServer.exe
	cd $BASE/src/server/NT
	if [ $ALL = Y ]
	then
		echo "CLEAN `pwd`"
		cmd /c msdev xpilots.dsp /MAKE "XPilotServer - Win32 $BUILDTYPE" /CLEAN
	fi
	cmd /c msdev xpilots.dsp /MAKE "XPilotServer - Win32 $BUILDTYPE"
	if [ $? != 0 ]
	then
		echo "makeDistribution: failed to build XPilotServer.exe"
		exit 1
	fi
fi

#####################################################################
#
# go make XPScoreServer.exe
#
if [ $QUICK = N ]
then
	echo go make XPScoreServer.exe
	cd $BASE/src/scoreserver
	if [ $ALL = Y ]
	then
		echo "CLEAN `pwd`"
		cmd /c msdev XPScoreServer.dsp /MAKE "XPScoreServer - Win32 $BUILDTYPE" /CLEAN
	fi
	cmd /c msdev XPScoreServer.dsp /MAKE "XPScoreServer - Win32 $BUILDTYPE"
	if [ $? != 0 ]
	then
		echo "makeDistribution: failed to build XPScoreServer.exe"
		exit 1
	fi
fi

#####################################################################
#
# go make XPreplay.exe
#
if [ $QUICK = N ]
then
	echo go make XPreplay.exe
	cd $BASE/src/replay/NT
	if [ $ALL = Y ]
	then
		echo "CLEAN `pwd`"
		cmd /c msdev XPreplay.dsp /MAKE "XPreplay - Win32 $BUILDTYPE" /CLEAN
	fi
	cmd /c msdev XPreplay.dsp /MAKE "XPreplay - Win32 $BUILDTYPE"
	if [ $? != 0 ]
	then
		echo "makeDistribution: failed to build XPreplay.exe"
		exit 1
	fi
fi

#####################################################################
#
# go make XPilot5.exe
#
if [ $QUICK = N ]
then
	echo go make XPilot5.exe
	cd $BASE/src/control
	if [ $ALL = Y ]
	then
		echo "CLEAN `pwd`"
		cmd /c msdev XPilot5.dsp /MAKE "XPilot5 - Win32 $BUILDTYPE" /CLEAN
	fi
	cmd /c msdev XPilot5.dsp /MAKE "XPilot5 - Win32 $BUILDTYPE"
	if [ $? != 0 ]
	then
		echo "makeDistribution: failed to build XPilot5.exe"
		exit 1
	fi
fi

#####################################################################
#
# see if the output directory exists
#
if [ ! -d "$XDIR" ]
then
	echo -n "Stage directory $XDIR doesn't exist. Create? [y] "
	read K
	if [ "x$K" = "x" ]
	then
		K=y
	fi
	if [ $K = y -o $K = Y ]
	then
		mkdir -p $XDIR
	else
		exit 1
	fi
fi
if [ ! -d "$XDIR" ] ; then
	echo "Can't build to non-existant directory"
	exit 1
fi

#####################################################################
#
# make all of our output subdirectories
#
if [ ! -d $XDIR/doc ]
then
	mkdir $XDIR/doc
fi
if [ ! -d $XDIR/lib ]
then
	mkdir $XDIR/lib
fi
if [ ! -d $XDIR/lib/maps ]
then
	mkdir $XDIR/lib/maps
fi
if [ ! -d $XDIR/lib/sounds ]
then
	mkdir $XDIR/lib/sounds
fi
if [ ! -d $XDIR/lib/textures ]
then
	mkdir $XDIR/lib/textures
fi
if [ ! -d $XDIR/lib/scoreserver ]; then
	mkdir $XDIR/lib/scoreserver
fi
if [ ! -d $XDIR/lib/scoreserver/html ]; then
	mkdir $XDIR/lib/scoreserver/html
fi
if [ ! -d $XDIR/lib/scoreserver/html/g ]; then
	mkdir $XDIR/lib/scoreserver/html/g
fi
if [ $COPYBITMAPS = Y ]; then
	if [ ! -d $XDIR/lib/buttons ]; then
		mkdir $XDIR/lib/buttons
	fi
fi

#####################################################################
#
# Pre-write the buttons install-include file
#
echo "#xpebuttons-nsi.txt - define buttons needed by XPilot5" >$XDIR/xpebuttons-nsi.txt
echo "# file generated by ./makeDistribution" >>$XDIR/xpebuttons-nsi.txt

#####################################################################
#
# Make sure we have InstallOptions.dll staged, which is needed
# by the password chooser dialog.
#
INSFILE="$NSIS/Plugins/InstallOptions.dll"
if [ ! -f "$XDIR/InstallOptions.dll" ]; then
	if [ -f "$INSFILE" ]; then
		echo "Copying InstallOptions.dll to staged"
		cp "$INSFILE" $XDIR
	else
		echo "Can't find InstallOptions.dll"
		echo "Did you set your \$NSIS variable correctly?"
		echo "And do you need to build InstallOptions.dll?"
		ls -l "$INSFILE"
		exit 1
	fi
fi

# Are we supplying bitmaps for XPilot?
if [ $COPYBITMAPS = Y ]		# well we'd better, bad things happen if we don't.
then
	cd $BASE/src/control/buttons
	BMPS=`echo *.xpm *.png`
	echo "Copying bitmaps: $BMPS"
	#echo "SetOutPath \"\$INSTDIR\\lib\\buttons\"" >>$XDIR/xpebuttons-nsi.txt
	for i in $BMPS
	do
		cp -p $i $XDIR/lib/buttons
		echo "File \"lib\buttons\\$i\"" >>$XDIR/xpebuttons-nsi.txt
	done
	cd $BASE/src/control/res
	BMPS=`echo *.png`
	for i in $BMPS
	do
		cp -p $i $XDIR/lib/buttons
		echo "File \"lib\buttons\\$i\"" >>$XDIR/xpebuttons-nsi.txt
	done
fi

#####################################################################
#
# build our output title string to use as the filename of the installer .exe
#
cd $BASE
#TITLE=`grep TITLE src/common/version.h | grep -v XPilot | cut -f2 -d'"'`
TITLE=`grep VERSION src/common/version.h | grep define | grep -v _H | cut -f2 -d'"'`
EXE="XPilot-$TITLE.exe"
echo "Building $EXE"
echo "OutFile $EXE" >$XDIR/outfilename.txt

ZIP="xpilot-$TITLE.zip"
echo $ZIP >$XDIR/outsrcfilename.txt

#####################################################################
#
# copy all files over to the staged dir
#
if [ $REALQUICK = Y ]
then
	$ECHO_ON	# thanks for looking.
	cd $BASE/inst/win32
	sed "s/\[PRODUCT\]/$PRODUCT/g" <XPilot.nsi >$XDIR/temp.nsi
	sed "s/\[RELEASE\]/XPilot$TITLE/g" <$XDIR/temp.nsi >$XDIR/XPilot.nsi
	$ECHO_OFF
else

	$ECHO_ON	# thanks for looking.

	cd $BASE
	cp -p LICENSE $XDIR/License.txt

