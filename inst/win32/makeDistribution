	cd $BASE/lib/scoreserver/html
	cp -p index.html		$XDIR/lib/scoreserver/html
	cp -p playerline.html	$XDIR/lib/scoreserver/html
	cp -p scorelist.html	$XDIR/lib/scoreserver/html

	cd $BASE/lib/scoreserver/html/g
	cp -p xpback.png		$XDIR/lib/scoreserver/html/g
