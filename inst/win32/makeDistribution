	cd $BASE/src/server/NT
	cp -p $BUILDTYPE/XPilotServer.exe $XDIR

	cd $BASE/inst/win32
	sed "s/\[PRODUCT\]/$PRODUCT/g" <XPilot.nsi >$XDIR/temp.nsi
