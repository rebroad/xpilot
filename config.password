#!/bin/sh
# config.password - Setup the password for this server that we will use
# $Id: config.password,v 1.3 2004/03/02 04:58:37 dick Exp $
# $Log: config.password,v $
# Revision 1.3  2004/03/02 04:58:37  dick
# You can't use ^C to abort password change (exits make)
#
# Revision 1.2  2004/01/28 05:52:05  dick
# Echo the current password (if any) before entering a new one
#
# Revision 1.1  2002/07/21 19:27:06  dick
# Configure and install the server password.
#

PWFILE=".serverpassword"
PW="No currently have no password"

if [ -f $PWFILE ]; then
	PWF=`cat $PWFILE`
	PW="Your current $PWF"
fi

echo ""
echo "This script will create a password for your xpilot server"
echo "that will then be installed (when you do make install)"
echo "It does _NOT_ change any existing passwords on an"
echo "installed system".
echo ""
echo $PW
echo "Type the password you wish to use:"

read ALS
echo "You have set your password to '$ALS'"
echo "password:$ALS" >.serverpassword
chmod 600 .serverpassword
echo "localhost:15345 $ALS" >.servercookie
chmod 600 .servercookie
