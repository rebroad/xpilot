# Linux needs to install client sound.conf and sounds/*.wav
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:

distclean: clean

depend:

################################################################

install:
	@echo "=== installing sounds to $(SOUNDDIR)"
	@if [ ! -d $(SOUNDDIR) ]; then \
		mkdir $(SOUNDDIR) ;\
	fi
	@for sound in *.wav; do\
		echo $(ECHO_N) ".";\
		cp -f -p $$sound $(SOUNDDIR);\
		chmod 444 $(SOUNDDIR)/$$sound;\
	done
	@echo ""

#
# End of "$Id: Makefile.in,v 1.1 2004/05/04 00:23:30 dick Exp $".
