# Revision 1.1  2004/02/03 07:03:14  dick
# Install the scoreserver web pages on unix.
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

SCHGDIR = $(XPLIBDIR)/scoreserver/html/g
################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:

distclean: clean

depend:

################################################################

install:
	@echo "=== installing scoreserver html to $(SCHGDIR)"
	@if [ ! -d $(SCHGDIR) ]; then \
		mkdir $(SCHGDIR) ;\
	fi
	@for map in *.css *.png; do\
		echo $(ECHO_N) ".";\
		cp -f -p $$map $(SCHGDIR);\
		chmod 444 $(SCHGDIR)/$$map;\
	done
	@echo ""
	#@for dir in $(SUBDIRS); do\
	#	echo "=== installing $$dir ===";\
	#	(cd $$dir; $(MAKE) $(MFLAGS) install) || exit 1;\
	#done

