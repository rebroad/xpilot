# $Log: Makefile.in,v $
# Revision 1.4  2004/01/28 05:53:13  dick
# Force the make to die on failure by using "exit 1" instead of "break" in the loops.
# Tidy up the make install output.
#
# Revision 1.3  2004/01/20 06:13:53  dick
# Add support for `make install` to a non-priv'd directory, like /home/dick/xpilot.
# If we are doing a default installation (/usr/local/xpilot) then the VARDIR
# becomes /var/xpilot .  If we are not default then use $prefix/var.
#
# Revision 1.2  2002/02/17 22:29:19  dick
# During install, mkdir $/lib/textures if needed
#
# Revision 1.1  2001/10/24 16:40:19  dick
# Add support for "make install"
#

LIBNAME =

SUBDIRS =

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:

clean:

distclean: clean

depend:

################################################################

install:
	echo "=== installing textures to $(TEXTUREDIR)"
	@if [ ! -d $(TEXTUREDIR) ]; then \
		mkdir $(TEXTUREDIR) ;\
	fi
	@for texture in *.xpm *.ppm; do\
		echo $(ECHO_N) ".";\
		cp -f -p $$texture $(TEXTUREDIR);\
		chmod 444 $(TEXTUREDIR)/$$texture;\
	done
	@echo ""

#
# End of "$Id: Makefile.in,v 1.4 2004/01/28 05:53:13 dick Exp $".
#
