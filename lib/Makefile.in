LIBNAME =

SUBDIRS = maps scoreserver textures @CLIENTSOUNDDIR@

INSTALLFILES = defaults robots XPilot.shp @CLIENTSOUNDCONF@

CPPFILES =

CLEAN =

################################################################
TOP=@top_srcdir@

include @top_srcdir@/makeinclude

XPCXXFLAGS =

OBJECTS = $(CPPFILES:.cpp=.o) $(CFILES:.c=.o)

all:	$(LIBNAME) $(SUBDIRS)
	@for dir in $(SUBDIRS); do\
		echo "=== making $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS)) || exit 1;\
	done

$(LIBNAME): $(OBJECTS)
	echo $(LIBCOMMAND) $@ ...
	$(LIBCOMMAND) $@ $(OBJECTS)
	$(RANLIB) $@


clean:
	-@ rm -f *.o *.do $(CLEAN) core *~ .depend cmap
	@for dir in $(SUBDIRS); do\
		echo "=== cleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) clean) || exit 1;\
	done

distclean: clean
	-@ rm -f Makefile
	@for dir in $(SUBDIRS); do\
		echo "=== distcleaning $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) distclean) || exit 1;\
	done

depend:
	@for dir in $(SUBDIRS); do\
		echo "=== makdepending $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) depend) || exit 1;\
	done


################################################################

install:
	@if [ ! -d $(XPLIBDIR) ]; then \
		mkdir $(XPLIBDIR) ;\
	fi
	@if [ -f sounds ]; then \
		rm -f sounds ;\
	fi
	for file in $(INSTALLFILES); do\
		if [ ! -f $(XPLIBDIR)/$$file ] ; then \
			echo "installing lib file \"$(XPLIBDIR)/$$file\" ";\
			cp -p $$file $(XPLIBDIR);\
			chmod 444 $(XPLIBDIR)/$$file;\
		else\
			echo "not overwriting existing $$file file ";\
		fi\
	done
	@for dir in $(SUBDIRS); do\
		echo "=== installing $$dir ===";\
		(cd $$dir; $(MAKE) $(MFLAGS) install) || exit 1;\
	done

#
# End of "$Id: Makefile.in,v 1.10 2004/05/13 16:21:19 dick Exp $".
